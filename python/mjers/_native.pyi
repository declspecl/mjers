from typing import Annotated

import numpy as np
from numpy.typing import NDArray

ENCODING_VERSION: int
ACTION_COUNT: int
TILE_PLANES: int
CONTEXT_SIZE: int

class Observation:
    @property
    def seat(self) -> int: ...
    @property
    def tiles(self) -> Annotated[NDArray[np.float32], "50 x 34"]: ...
    @property
    def context(self) -> Annotated[NDArray[np.float32], "22"]: ...
    @property
    def action_mask(self) -> Annotated[NDArray[np.bool_], "110"]: ...

class Transition:
    @property
    def observation(self) -> Observation | None: ...
    @property
    def rewards(self) -> list[int]: ...
    @property
    def terminated(self) -> bool: ...

class ActionAssessment:
    @property
    def index(self) -> int: ...
    @property
    def description(self) -> str: ...
    @property
    def shanten(self) -> int: ...
    @property
    def live_improving(self) -> int: ...
    @property
    def danger(self) -> float: ...
    @property
    def immediate_units(self) -> int: ...
    @property
    def reasons(self) -> list[str]: ...

class NeuralNet:
    """Rust inference for a suit-resnet-v2 state dict."""

    def __init__(self, tensors: dict[str, NDArray[np.float32]]) -> None: ...

class Env:
    """One seat's decision per step; use on its creating thread."""

    def __init__(self, teacher: str, *, rules: str) -> None: ...
    @property
    def rules_json(self) -> str: ...
    @property
    def teacher_json(self) -> str: ...
    @property
    def concealed_hand(self) -> str: ...
    def rank_actions(self) -> list[ActionAssessment]: ...
    def reset(self, seed: int, dealer: int) -> Observation | None: ...
    def observe(self) -> Observation | None: ...
    def step(self, action: int) -> Transition: ...
    def evaluate_network(self, net: NeuralNet) -> tuple[list[float], float]: ...
    def set_teacher_network(self, name: str, net: NeuralNet) -> None: ...
    def teacher_action(self) -> int: ...

class Arena:
    """One student seat per hand against a field playing in Rust; use on its creating thread."""

    def __init__(self, field: str, *, rules: str, slots: int) -> None: ...
    @property
    def rules_json(self) -> str: ...
    def start(self, slot: int, seed: int, seat: int) -> None: ...
    def pending(
        self,
    ) -> tuple[
        list[int],
        Annotated[NDArray[np.float32], "B x 50 x 34"],
        Annotated[NDArray[np.float32], "B x 22"],
        Annotated[NDArray[np.bool_], "B x 110"],
    ]: ...
    def act(self, slots: list[int], actions: list[int]) -> None: ...
    def set_field_network(self, name: str, net: NeuralNet) -> None: ...
    def take_finished(self) -> list[tuple[int, int, int, int]]: ...
